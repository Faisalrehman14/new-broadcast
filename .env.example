# Application
NODE_ENV=development
APP_NAME=CastMe Pro
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://pagebroadcast:pagebroadcast@localhost:5432/pagebroadcast?schema=public

# Redis / Queues
REDIS_URL=redis://localhost:6379

# Session & encryption (generate strong random values for production)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta / Facebook Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/facebook/callback
META_GRAPH_VERSION=v21.0
# Login dialog version (defaults to v25.0 in code if unset)
# META_OAUTH_DIALOG_VERSION=v25.0
# If Facebook lands on /oauth/business/cancel with empty business, try:
# META_OAUTH_EXCLUDE_BUSINESS=1
META_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify-token
META_PROVIDER=mock
# META_PROVIDER=meta  # use real Meta Graph API when credentials are set

# Rate limiting defaults (messages)
BROADCAST_MESSAGES_PER_SECOND=5
BROADCAST_MESSAGES_PER_MINUTE=200
BROADCAST_CONCURRENT_SENDS=3

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Admin bootstrap (created on seed if missing)
ADMIN_EMAIL=admin@pagebroadcast.local
ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_DEMO_USER_EMAIL=demo@pagebroadcast.local
SEED_DEMO_USER_PASSWORD=DemoPassword123!

# Email OTP (Resend preferred; without it OTP is logged in non-production)
RESEND_API_KEY=
EMAIL_FROM=CastMe Pro <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Alby Lightning billing (prepaid plans)
ALBY_API_TOKEN=
ALBY_LIGHTNING_ADDRESS=
BTC_USD_RATE=
ALBY_RECLAIM_INTERVAL_MS=45000
ALBY_RECLAIM_BATCH=20
