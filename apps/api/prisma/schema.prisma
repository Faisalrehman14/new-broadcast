generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FacebookAccountStatus {
  CONNECTED
  NEEDS_REAUTH
  PERMISSION_MISSING
  DISCONNECTED
  ERROR
}

enum PageConnectionStatus {
  CONNECTED
  SYNCING
  NEEDS_REAUTH
  DISCONNECTED
  ERROR
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TemplateSource {
  PAGEINTERACT
  LIBRARY
  CUSTOM
}

enum TemplateBodyStatus {
  ready
  requires_import
}

enum TemplateApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

enum BroadcastStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  PAUSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum RecipientDeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  SKIPPED
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  FACEBOOK_CONNECTED
  FACEBOOK_DISCONNECTED
  SYNC_COMPLETED
  SYNC_FAILED
  TEMPLATE_SUBMITTED
  TEMPLATE_APPROVED
  TEMPLATE_REJECTED
  BROADCAST_STARTED
  BROADCAST_COMPLETED
  BROADCAST_FAILED
  CONNECTION_LOST
  GENERIC
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  facebookAccounts FacebookAccount[]
  pageConnections  PageConnection[]
  broadcasts       Broadcast[]
  sessions         Session[]
  loginHistory     LoginHistory[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportTickets   SupportTicket[]
  settings         UserSettings?
  customTemplates  Template[]        @relation("UserTemplates")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ip        String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ip        String?
  userAgent String?  @map("user_agent")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

model FacebookAccount {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  platformUserId       String                @map("platform_user_id")
  encryptedAccessToken String                @map("encrypted_access_token")
  tokenExpiresAt       DateTime?             @map("token_expires_at")
  status               FacebookAccountStatus @default(CONNECTED)
  lastApiSuccessAt     DateTime?             @map("last_api_success_at")
  lastError            String?               @map("last_error")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages FacebookPage[]

  @@unique([userId, platformUserId])
  @@index([userId])
  @@map("facebook_accounts")
}

model FacebookPage {
  id                 String   @id @default(uuid())
  facebookAccountId  String   @map("facebook_account_id")
  platformPageId     String   @unique @map("platform_page_id")
  name               String
  profileImage       String?  @map("profile_image")
  category           String?
  encryptedPageToken String   @map("encrypted_page_token")
  status             String   @default("AVAILABLE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  facebookAccount FacebookAccount  @relation(fields: [facebookAccountId], references: [id], onDelete: Cascade)
  connections     PageConnection[]
  contacts        Contact[]
  syncJobs        SyncJob[]
  webhookEvents   WebhookEvent[]
  templateApprovals TemplateApproval[]
  broadcasts      Broadcast[]

  @@index([facebookAccountId])
  @@map("facebook_pages")
}

model PageConnection {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  pageId          String               @map("page_id")
  status          PageConnectionStatus @default(CONNECTED)
  webhookSubscribed Boolean            @default(false) @map("webhook_subscribed")
  lastSyncedAt    DateTime?            @map("last_synced_at")
  contactCount    Int                  @default(0) @map("contact_count")
  lastWebhookAt   DateTime?            @map("last_webhook_at")
  healthStatus    String               @default("Connected") @map("health_status")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, pageId])
  @@index([userId])
  @@index([pageId])
  @@map("page_connections")
}

model Contact {
  id                 String        @id @default(uuid())
  pageId             String        @map("page_id")
  platformUserId     String        @map("platform_user_id")
  name               String?
  profileImage       String?       @map("profile_image")
  firstSeenAt        DateTime      @default(now()) @map("first_seen_at")
  lastInteractionAt  DateTime?     @map("last_interaction_at")
  status             ContactStatus @default(ACTIVE)
  broadcastsReceived Int           @default(0) @map("broadcasts_received")
  lastBroadcastAt    DateTime?     @map("last_broadcast_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  page       FacebookPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tags       ContactTag[]
  events     ContactEvent[]
  recipients BroadcastRecipient[]

  @@unique([pageId, platformUserId])
  @@index([pageId])
  @@index([lastInteractionAt])
  @@index([status])
  @@index([name])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String   @default("#2563EB")
  createdAt DateTime @default(now()) @map("created_at")

  contacts ContactTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model ContactTag {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model ContactEvent {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  eventType String   @map("event_type")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@map("contact_events")
}

model Template {
  id         String            @id @default(uuid())
  title      String
  metaName   String            @unique @map("meta_name")
  category   String
  body       String?
  bodyStatus TemplateBodyStatus @default(ready) @map("body_status")
  source     TemplateSource
  status     TemplateApprovalStatus @default(DRAFT)
  isCustom   Boolean           @default(false) @map("is_custom")
  userId     String?           @map("user_id")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user       User?              @relation("UserTemplates", fields: [userId], references: [id], onDelete: Cascade)
  variables  TemplateVariable[]
  approvals  TemplateApproval[]
  broadcasts Broadcast[]

  @@index([source, category])
  @@index([userId])
  @@map("templates")
}

model TemplateVariable {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  key        String
  position   Int
  label      String?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@map("template_variables")
}

model TemplateApproval {
  id                 String                 @id @default(uuid())
  templateId         String                 @map("template_id")
  pageId             String                 @map("page_id")
  externalTemplateId String?                @map("external_template_id")
  status             TemplateApprovalStatus @default(DRAFT)
  submittedAt        DateTime?              @map("submitted_at")
  approvedAt         DateTime?              @map("approved_at")
  rejectedAt         DateTime?              @map("rejected_at")
  rejectionReason    String?                @map("rejection_reason")
  pollBackoffSeconds Int                    @default(5) @map("poll_backoff_seconds")
  nextPollAt         DateTime?              @map("next_poll_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  template Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  page     FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([templateId, pageId])
  @@index([status, nextPollAt])
  @@map("template_approvals")
}

model Broadcast {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  pageId          String          @map("page_id")
  templateId      String          @map("template_id")
  name            String
  status          BroadcastStatus @default(DRAFT)
  variableValues  Json            @default("{}") @map("variable_values")
  recipientMode   String          @map("recipient_mode")
  recipientFilter Json?           @map("recipient_filter")
  totalRecipients Int             @default(0) @map("total_recipients")
  queuedCount     Int             @default(0) @map("queued_count")
  sendingCount    Int             @default(0) @map("sending_count")
  sentCount       Int             @default(0) @map("sent_count")
  deliveredCount  Int             @default(0) @map("delivered_count")
  failedCount     Int             @default(0) @map("failed_count")
  readCount       Int             @default(0) @map("read_count")
  responseCount   Int             @default(0) @map("response_count")
  renderedBody    String?         @map("rendered_body")
  scheduledAt     DateTime?       @map("scheduled_at")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  page       FacebookPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  template   Template             @relation(fields: [templateId], references: [id])
  recipients BroadcastRecipient[]
  deliveries MessageDelivery[]

  @@index([userId, createdAt])
  @@index([pageId])
  @@index([status])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id            String                  @id @default(uuid())
  broadcastId   String                  @map("broadcast_id")
  contactId     String                  @map("contact_id")
  status        RecipientDeliveryStatus @default(PENDING)
  attemptCount  Int                     @default(0) @map("attempt_count")
  idempotencyKey String                 @unique @map("idempotency_key")
  queuedAt      DateTime?               @map("queued_at")
  sentAt        DateTime?               @map("sent_at")
  deliveredAt   DateTime?               @map("delivered_at")
  failedAt      DateTime?               @map("failed_at")
  failureReason String?                 @map("failure_reason")
  externalMessageId String?             @map("external_message_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  @@index([contactId])
  @@map("broadcast_recipients")
}

model MessageDelivery {
  id            String                  @id @default(uuid())
  broadcastId   String                  @map("broadcast_id")
  recipientId   String                  @map("recipient_id")
  status        RecipientDeliveryStatus
  payload       Json?
  error         String?
  createdAt     DateTime                @default(now()) @map("created_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, createdAt])
  @@map("message_deliveries")
}

model WebhookEvent {
  id              String   @id @default(uuid())
  pageId          String?  @map("page_id")
  eventType       String   @map("event_type")
  externalEventId String?  @map("external_event_id")
  payload         Json
  processed       Boolean  @default(false)
  processingError String?  @map("processing_error")
  createdAt       DateTime @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  page FacebookPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@unique([externalEventId])
  @@index([processed, createdAt])
  @@index([pageId])
  @@map("webhook_events")
}

model SyncJob {
  id             String        @id @default(uuid())
  pageId         String        @map("page_id")
  status         SyncJobStatus @default(PENDING)
  totalEstimated Int           @default(0) @map("total_estimated")
  processedCount Int           @default(0) @map("processed_count")
  cursor         String?
  error          String?
  startedAt      DateTime?     @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  page  FacebookPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items SyncJobItem[]

  @@index([pageId, status])
  @@map("sync_jobs")
}

model SyncJobItem {
  id        String   @id @default(uuid())
  syncJobId String   @map("sync_job_id")
  status    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_job_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  subject     String
  category    String
  description String
  priority    SupportTicketPriority @default(MEDIUM)
  status      SupportTicketStatus   @default(OPEN)
  attachmentUrl String?             @map("attachment_url")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model ApiLog {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  userId     String?  @map("user_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  durationMs Int      @map("duration_ms")
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([requestId])
  @@map("api_logs")
}

model UserSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  messagesPerSecond     Int      @default(5) @map("messages_per_second")
  messagesPerMinute     Int      @default(200) @map("messages_per_minute")
  concurrentSends       Int      @default(3) @map("concurrent_sends")
  maxRetries            Int      @default(5) @map("max_retries")
  notifyTemplateApproved Boolean @default(true) @map("notify_template_approved")
  notifyTemplateRejected Boolean @default(true) @map("notify_template_rejected")
  notifyBroadcastCompleted Boolean @default(true) @map("notify_broadcast_completed")
  notifyBroadcastFailed Boolean  @default(true) @map("notify_broadcast_failed")
  notifyConnectionLost  Boolean  @default(true) @map("notify_connection_lost")
  retentionDays         Int      @default(365) @map("retention_days")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
