{
  "name": "@pagebroadcast/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "sh -c 'test -f dist/index.js || npm run build; exec node dist/index.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pagebroadcast/config": "*",
    "@pagebroadcast/meta-provider": "*",
    "@pagebroadcast/types": "*",
    "@pagebroadcast/validation": "*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.25.5",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  }
}
